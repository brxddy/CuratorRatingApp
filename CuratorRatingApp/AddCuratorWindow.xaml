<Window x:Class="CuratorRatingApp.AddCuratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="➕ Добавление куратора" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Введите данные нового куратора" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- ФИО -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="ФИО:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="tbFullName" Grid.Row="1" Grid.Column="1" 
                 Height="30" Margin="0,0,0,5"/>

        <!-- Кафедра -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Кафедра:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="tbDepartment" Grid.Row="2" Grid.Column="1" 
                 Height="30" Margin="0,0,0,5"/>

        <!-- Рейтинг -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Рейтинг:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="tbRating" Grid.Row="3" Grid.Column="1" 
                 Height="30" Margin="0,0,0,5" Text="0"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="💾 Сохранить" 
                    Width="120" Height="35" Margin="0,0,15,0" 
                    Click="SaveButton_Click" Background="#90EE90"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" 
                    Width="120" Height="35" 
                    Click="CancelButton_Click" Background="#FF6B6B"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Grid.ColumnSpan="2" 
                   Text="" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>