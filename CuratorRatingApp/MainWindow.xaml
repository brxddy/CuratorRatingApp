<Window x:Class="CuratorRatingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рейтинг кураторов" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="📊 Рейтинг кураторов учебных групп" 
                   FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15" Grid.Row="0"/>

        <!-- Верхняя панель кнопок -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="LoadButton" Content="📋 Загрузить" 
                    Width="100" Height="30" Margin="0,0,10,0" Click="LoadButton_Click"/>
            <Button x:Name="RefreshButton" Content="🔄 Обновить" 
                    Width="100" Height="30" Margin="0,0,10,0" Click="RefreshButton_Click"/>
            <Button x:Name="AddButton" Content="➕ Добавить" 
                    Width="100" Height="30" Margin="0,0,10,0" Click="AddButton_Click" Background="#90EE90"/>
            <Button x:Name="DeleteButton" Content="❌ Удалить" 
                    Width="100" Height="30" Margin="0,0,10,0" Click="DeleteButton_Click" Background="#FF6B6B"/>
            <Button x:Name="StatsButton" Content="📊 Статистика" 
                    Width="100" Height="30" Margin="0,0,10,0" Click="StatsButton_Click" Background="#87CEEB"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="CuratorsGrid" Grid.Row="2" 
                  AutoGenerateColumns="True" 
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  Margin="0,5,0,10"
                  AlternatingRowBackground="#F0F0F0"
                  Background="White"/>

        <!-- Нижняя строка статуса -->
        <TextBlock x:Name="StatusText" Grid.Row="3" 
                   Text="✅ Готов к работе" 
                   FontSize="12" Foreground="Gray"/>
    </Grid>
</Window>